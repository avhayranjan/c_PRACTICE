
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Git Add Commit and Push",
            "type": "shell",
            "command": "git add -A; if ($?) { git -c core.quotePath=false commit -m 'Auto-update' }; if ($?) { git push }",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-Command"
                    ]
                }
            },
            "problemMatcher": []
        }
    ]
}


